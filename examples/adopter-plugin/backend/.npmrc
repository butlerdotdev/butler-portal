; @backstage/cli@0.36.4 declares peerOptional jsdom@^27.1.0 while its
; own transitive jest-environment-jsdom@30.4.1 brings jsdom@29. npm 9+
; rejects the peer conflict; yarn (which butler-portal uses everywhere
; else) resolves it via its looser peer strategy. Adopters copying this
; example who use npm need the same accommodation until @backstage/cli
; ships a version that either relaxes the peer range or matches the
; transitive jsdom version.
legacy-peer-deps=true
